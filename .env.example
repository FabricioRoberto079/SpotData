# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# LLM model selection (provider prefix required)
# Format: <provider>:<model>. Providers: openai, google_genai, anthropic, ...
# Switching providers = edit these 3 lines + the matching API key below.
LLM_CHAT_MODEL=
LLM_STRUCTURED_MODEL=
LLM_EMBEDDING_MODEL=

# Embedding vector dimension. MUST match LLM_EMBEDDING_MODEL output:
# openai:text-embedding-3-large = 3072
# openai:text-embedding-3-small = 1536
# openai:text-embedding-ada-002 = 1536
# google_genai:text-embedding-004 = 768
# Changing this requires re-indexing the entire corpus.
EMBEDDING_DIMENSION=

# API keys (set the one matching your provider; leave the others empty)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# JWT auth
# JWT_SECRET: random string used to sign tokens. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# SMTP (password-reset emails)
# Port 465 uses implicit SSL; any other port (e.g. 587) uses STARTTLS.
# SMTP_FROM is the visible sender address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# API
# CORS_ORIGINS: comma-separated list of allowed origins (e.g. http://localhost:3000).
# Never use "*" together with credentials in production.
CORS_ORIGINS=
LOG_LEVEL=INFO
