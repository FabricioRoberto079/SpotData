# Postgres
POSTGRES_USER=spotdata
POSTGRES_PASSWORD=spotdata123
POSTGRES_DB=spotdata
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# LLM model selection (provider prefix required)
# Format: <provider>:<model>. Providers: openai, google_genai, anthropic, ...
# Switching providers = edit these 3 lines + the matching API key below.
LLM_CHAT_MODEL=openai:gpt-4o-mini
LLM_STRUCTURED_MODEL=openai:gpt-4o-mini
LLM_EMBEDDING_MODEL=openai:text-embedding-3-small

# API keys (set the one matching your provider; leave the others empty)
OPENAI_API_KEY=sk-replace-me
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# JWT auth
# JWT_SECRET: random string used to sign tokens. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# API
# CORS_ORIGINS: comma-separated list. * allows all (dev only).
CORS_ORIGINS=*
LOG_LEVEL=INFO
